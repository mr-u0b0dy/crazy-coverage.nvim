# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4
indent_style = tab
tab_width = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.{c,h,cpp,hpp,py,sh}]
indent_size = 4
indent_style = tab

[*.{go,mod}]
indent_size = 4
indent_style = tab
tab_width = 4

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
